# Flask Configuration
# python -c 'import secrets; print(secrets.token_hex())'
FLASK_SECRET_KEY=your_random_secret_key_here
FLASK_ENV=development
PORT=3001

# Application Details
APP_DOMAIN=your-app-domain.com
APP_BASE_URL=https://your-app-domain.com

# Database Configuration
DATABASE_URL=bluesky_trends.sqlite

# ClickHouse Configuration
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=9000
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=default

# OAuth Configuration
# If using a confidential client (optional), generate with:
# python generate_jwk.py
FLASK_CLIENT_SECRET_JWK=

# Push Notification Service (for future implementation)
PUSH_SERVICE_API_KEY=
PUSH_SERVICE_APP_ID=
